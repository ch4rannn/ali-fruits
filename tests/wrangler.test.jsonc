{
  "name": "fruit-delivery-test",
  "main": "../src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "test", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "test" }],
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_SITE_URL": "https://shop.test",
    "SELLER_DETAILS_VERIFIED": "true",
    "FSSAI_COVERAGE_VERIFIED": "true",
    "ONLINE_SALES_ENABLED": "true"
  }
}
