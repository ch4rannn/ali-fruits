{
  "name": "ali-fruits",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite build && vite preview",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest --no-file-parallelism",
    "typecheck": "tsc -b",
    "types": "wrangler types",
    "icons": "node scripts/generate-icons.mjs",
    "android:apk": "node scripts/android-apk.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=seeds/dev.sql",
    "db:reset:local": "node scripts/reset-local-db.mjs && npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "deploy:staging": "cross-env CLOUDFLARE_ENV=staging vite build && wrangler deploy",
    "deploy:production": "cross-env CLOUDFLARE_ENV=production vite build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-query": "^5.105.0",
    "hono": "^4.13.16",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.0"
  }
}
